# Keep disabled until the merchant, webhook and fiscal settings are verified.
PAYMENTS_ENABLED=0

# For the current AGAYO owner on NPD: set to 1 only after the «Мой налог» receipt + refund/reissue workflow has been tested.
# This is an internal production-readiness flag; it does NOT enable YooKassa fiscal receipts.
FISCALIZATION_CONFIRMED=0

# NPD: keep YooKassa 54-FZ receipts disabled and leave VAT/payment receipt fields empty.
YOOKASSA_RECEIPT_REQUIRED=0
YOOKASSA_VAT_CODE=
YOOKASSA_PAYMENT_MODE=
YOOKASSA_PAYMENT_SUBJECT=
