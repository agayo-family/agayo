.event-landing { --landing-red:#C21F39; --landing-paper:#F2F0EA; background:#0B0B0C; color:var(--landing-paper); }
.event-landing .site-header { position:absolute;mix-blend-mode:normal;padding:26px 5vw; }
.event-landing .section-pad { padding:100px 6vw; }
.event-landing .section-label { font-size:10px;letter-spacing:.18em; }
.landing-hero { position:relative;min-height:100svh;padding:145px 6vw 72px;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.85fr);align-items:center;gap:5vw;isolation:isolate;overflow:hidden; }
.landing-hero::before { content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(ellipse at 72% 32%,rgba(194,31,57,.2),transparent 65%),linear-gradient(135deg,#171012,#0B0B0C 70%); }
.landing-kicker { display:flex;align-items:center;gap:10px;text-transform:uppercase;font-size:10px;letter-spacing:.18em;color:#D5C4C8; }
.landing-live-dot { height:6px;width:6px;flex:0 0 6px;border-radius:50%;background:var(--landing-red);box-shadow:0 0 18px rgba(194,31,57,.6); }
.landing-hero h1 { margin:28px 0;font-size:clamp(48px,6.2vw,104px);line-height:.94;letter-spacing:-.055em;text-transform:uppercase;overflow-wrap:anywhere; }
.landing-hero-meta { margin:0;color:#D7CFD0;font-size:15px;line-height:1.7; }
.landing-actions { display:flex;align-items:center;gap:26px;flex-wrap:wrap;margin-top:32px; }
.event-landing .button-link-accent { background:var(--landing-red);border-color:var(--landing-red);min-height:54px;padding:17px 22px;justify-content:space-between; }
.event-landing .button-link-accent:hover { background:#A71730; }
.event-landing .button-link-accent span { color:var(--landing-paper); }
.landing-secondary-link { font-size:11px;display:flex;align-items:center;gap:14px;min-height:44px; }
.landing-secondary-link span { color:#CF8795; }
.landing-poster { position:relative;aspect-ratio:4/5;border:1px solid #483137;box-shadow:0 28px 100px rgba(0,0,0,.5);background:#211116; }
.landing-poster-image { object-fit:cover; }
.landing-atmosphere { aspect-ratio:4/4.8; }
.landing-poster-caption { position:absolute;inset:auto -1px -1px;display:flex;justify-content:space-between;gap:14px;padding:14px 18px;font-size:8px;letter-spacing:.16em;background:#0B0B0C;border:1px solid #483137; }
.landing-hero-foot { position:absolute;bottom:22px;left:6vw;right:6vw;display:flex;justify-content:space-between;align-items:center;gap:20px;font-size:8px;letter-spacing:.18em;color:#A9989E; }
.landing-hero-foot a { display:grid;place-items:center;width:32px;height:32px;border:1px solid #4A353E;border-radius:50%;font-size:15px;color:var(--landing-paper); }
.landing-section-heading h2,.landing-team h2,.landing-final h2,.landing-empty h2 { margin:0;font-size:clamp(42px,5.2vw,76px);line-height:.99;letter-spacing:-.055em;text-wrap:balance; }
.landing-section-heading { margin:38px 0 44px;display:flex;justify-content:space-between;align-items:flex-end;gap:35px; }
.landing-section-heading p { max-width:290px;color:#BFB4B8;font-size:14px;line-height:1.6;margin:0; }
.landing-agenda { background:#100d10;border-top:1px solid #34272d; }
.landing-agenda-heading-note { display:grid;gap:18px; }
.landing-agenda-heading-note .text-link { font-size:11px; }
.landing-agenda-month + .landing-agenda-month { margin-top:55px; }
.landing-month-heading { display:flex;justify-content:space-between;align-items:center;gap:20px;border-top:1px solid #46313a;padding:22px 0; }
.landing-month-heading h3 { margin:0;font-size:23px;text-transform:uppercase;font-weight:500;letter-spacing:-.03em; }
.landing-month-heading>span { font-size:10px;color:#bbaaaf; }
.landing-agenda-grid { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px; }
.landing-agenda-card { display:flex;flex-direction:column;background:#1a1216;border:1px solid #443038;min-width:0; }
.landing-agenda-cover { position:relative;aspect-ratio:4/4.6;display:block;overflow:hidden;background:#120d10; }
.landing-agenda-cover img { object-fit:contain;transition:transform .4s ease; }
.landing-agenda-cover:hover img { transform:scale(1.025); }
.landing-agenda-cover>span { position:absolute;top:14px;right:14px;padding:9px 10px;background:#170e13d9;backdrop-filter:blur(8px);border:1px solid #795363;font-size:9px; }
.landing-agenda-card-content { display:flex;flex-direction:column;flex:1;padding:24px; }
.landing-agenda-date { display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px;color:#dc9dab; }
.landing-agenda-date time { font-size:21px;letter-spacing:-.02em; }
.landing-agenda-date>span { font-size:10px; }
.landing-agenda-card h4 { font-size:clamp(23px,2.4vw,34px);line-height:1.07;letter-spacing:-.04em;text-wrap:balance;overflow-wrap:anywhere;margin:24px 0 16px; }
.landing-agenda-place { margin:0;color:#e0d3d7;font-size:12px;line-height:1.6; }
.landing-agenda-place span { display:block;font-size:10px;color:#a48e98;margin-top:3px; }
.landing-agenda-status { display:flex;gap:8px;align-items:center;color:#bca6ae;font-size:10px;margin:20px 0; }
.landing-agenda-status i { width:5px;height:5px;border-radius:50%;background:#a48e98; }
.landing-agenda-status .is-open { background:#e44e65; }
.landing-agenda-card .button-link { margin-top:auto;min-height:44px;justify-content:space-between;font-size:11px;border-color:#65414e; }
.landing-agenda-card .button-link span { color:#e3849a; }
.landing-agenda-grid.is-single { grid-template-columns:1fr; }
.landing-agenda-grid.is-single .landing-agenda-card { display:grid;grid-template-columns:minmax(0,.65fr) minmax(0,1fr); }
.landing-agenda-grid.is-single .landing-agenda-card-content { padding:clamp(24px,4vw,55px); }
.landing-agenda-grid.is-single .landing-agenda-cover { max-height:480px; }
.landing-agenda-grid.is-single .landing-agenda-card h4 { font-size:clamp(28px,3.7vw,48px); }
.landing-agenda-later { margin-top:45px; }
.landing-agenda-later>summary { list-style:none;cursor:pointer;border-block:1px solid #46313a;display:flex;justify-content:space-between;align-items:center;padding:23px 0;color:#dca0b1;font-size:14px; }
.landing-agenda-later>summary::-webkit-details-marker { display:none; }
.landing-agenda-later>summary span { font-size:24px; }
.landing-agenda-later[open]>summary { border-bottom:0; }
.landing-agenda-later[open]>summary span { transform:rotate(45deg); }
@media(max-width:1000px) { .landing-agenda-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
@media(max-width:600px) {
  .landing-agenda-grid { grid-template-columns:1fr;gap:25px; }
  .landing-agenda-card-content { padding:22px; }
  .landing-agenda-card h4 { font-size:30px; }
  .landing-month-heading h3 { font-size:21px; }
  .landing-month-heading>span { font-size:9px; }
  .landing-agenda-grid.is-single .landing-agenda-card { grid-template-columns:1fr; }
  .landing-agenda-grid.is-single .landing-agenda-card h4 { font-size:30px; }
}
.landing-photo-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:22px; }
.landing-photo>div { position:relative;aspect-ratio:4/5;overflow:hidden;background:#211116; }
.landing-photo:nth-child(2)>div { aspect-ratio:4/4.4; }
.landing-photo img { object-fit:cover;transition:transform .5s ease; }
.landing-photo:hover img { transform:scale(1.035); }
.landing-photo>span { margin-top:14px;display:flex;justify-content:space-between;gap:15px;font-size:10px;line-height:1.4;color:#D5C4C8; }
.landing-photo b { color:#D69DAA; }
.landing-team { border-block:1px solid #413238;display:grid;grid-template-columns:1fr 2fr;gap:32px; }
.landing-team h2 { font-size:clamp(32px,4vw,58px); }
.landing-team .text-link { grid-column:2;justify-self:start; }
.landing-final { background:radial-gradient(ellipse at 20% 95%,#4D1120,#180D12 70%); }
.landing-final h2 { margin-top:32px;font-size:clamp(52px,8vw,116px); }
.landing-final p { color:#D5C4C8;margin:28px 0;line-height:1.5;font-size:14px; }
.landing-empty { border-top:1px solid #34272d;background:#100d10; }
.landing-empty h2 { margin-top:30px; }
.landing-empty p { margin:26px 0;color:#bfb4b8;font-size:15px;line-height:1.6; }
.event-landing .footer p { line-height:1.6; }
@media(max-width:900px) {
  .event-landing .site-header { padding:22px; }
  .event-landing .section-pad { padding:72px 22px; }
  .landing-hero { padding:120px 22px 72px;grid-template-columns:1fr;gap:44px; }
  .landing-hero h1 { max-width:680px;font-size:clamp(40px,8vw,70px); }
  .landing-poster { width:min(100%,500px);justify-self:center; }
  .landing-hero-foot { left:22px;right:22px; }
  .landing-section-heading { align-items:flex-start; }
  .landing-section-heading h2 { font-size:clamp(42px,7vw,66px); }
  .landing-photo-grid { grid-template-columns:repeat(2,1fr); }
  .landing-photo:nth-child(2)>div { aspect-ratio:4/5; }
  .landing-photo:last-child { display:none; }
  .landing-team { grid-template-columns:1fr;gap:25px; }
  .landing-team .text-link { grid-column:1; }
}
@media(max-width:600px) {
  .event-landing .site-header { padding:20px 18px; }
  .event-landing .section-pad { padding:64px 18px; }
  .landing-hero { padding:112px 18px 65px;gap:34px; }
  .landing-hero h1 { font-size:clamp(36px,9.3vw,56px);margin:24px 0; }
  .landing-hero-meta { font-size:12px;gap:4px 12px; }
  .landing-actions { gap:18px;margin-top:27px; }
  .landing-actions>.button-link { width:100%; }
  .landing-hero-foot { left:18px;right:18px;font-size:7px; }
  .landing-section-heading { flex-direction:column;align-items:flex-start;gap:22px;margin:30px 0; }
  .landing-section-heading h2 { font-size:clamp(36px,10vw,52px); }
  .landing-photo-grid { grid-template-columns:1fr;gap:28px; }
  .landing-photo:last-child { display:block; }
  .landing-photo>div { aspect-ratio:5/4; }
  .landing-photo:nth-child(2)>div { aspect-ratio:5/4; }
  .landing-team h2 { font-size:clamp(30px,8.5vw,44px); }
  .landing-final h2 { font-size:clamp(42px,11vw,68px); }
  .landing-hero { display:flex;align-items:stretch;justify-content:center;flex-direction:column;min-height:100svh;gap:0;padding:115px 18px 85px; }
  .landing-hero-copy { position:relative;z-index:2; }
  .landing-hero h1 { font-size:clamp(43px,12.4vw,72px);line-height:.98; }
  .landing-atmosphere { position:absolute;inset:0;z-index:-1;width:100%;height:100%;aspect-ratio:auto;opacity:.8;border:0;box-shadow:none; }
  .landing-atmosphere::after { content:"";position:absolute;inset:0;background:linear-gradient(0deg,#0b0b0cf7,#0b0b0cd0 38%,#0b0b0c90); }
  .landing-atmosphere .landing-poster-caption { display:none; }
}
/* Restored AGAYO: nearest poster, brand headline, manual event selection. */
.landing-hero { display:flex;align-items:center;min-height:100svh; }
.landing-hero-copy { position:relative;z-index:2;max-width:930px;animation:agayo-content-reveal 1.1s cubic-bezier(.22,1,.36,1) backwards; }
.landing-hero h1 { font-size:clamp(40px,6.5vw,98px);line-height:1.02;letter-spacing:-.05em; }
.landing-hero h1 span { color:#ead2d9; }
.landing-hero-backdrop { position:absolute;inset:0;z-index:-1; }
.landing-hero-backdrop img { object-fit:cover;object-position:72% center; }
.landing-hero-backdrop::after { content:"";position:absolute;inset:0;background:linear-gradient(90deg,#10090de8 0%,#1e0a13a8 48%,#210d1847),linear-gradient(0deg,#0b0b0c,transparent 45%); }
.landing-team { background:radial-gradient(ellipse at 0 70%,#3d0d1b55,transparent 65%),#0b0b0c; }
.landing-team p { max-width:560px;color:#d1bbc2;line-height:1.75;margin:24px 0; }
.landing-team .text-link { display:inline-flex;margin-top:5px; }
.landing-agenda { background:linear-gradient(145deg,var(--agenda-primary,#100d10),color-mix(in srgb,var(--agenda-secondary,#4b0f19) 62%,#0b0b0c));transition:background-color .6s ease; }
.landing-agenda-card { background:color-mix(in srgb,var(--agenda-secondary) 22%,#0b0b0c);border-color:color-mix(in srgb,var(--agenda-accent) 40%,#252026);animation:agayo-content-reveal .6s ease backwards; }
.landing-agenda-card[hidden] { display:none !important; }
.landing-agenda-card h3 { font-size:clamp(28px,3.7vw,48px);line-height:1.07;letter-spacing:-.04em;text-wrap:balance;overflow-wrap:anywhere;margin:24px 0 16px; }
.landing-agenda-date { color:#f4d4dc; }
.landing-agenda-card .button-link { border-color:var(--agenda-accent);color:#fff; }
.landing-agenda-card .button-link span { color:var(--agenda-accent); }
.agenda-controls { display:flex;align-items:center;justify-content:space-between;margin:0 0 24px;gap:20px; }
.agenda-controls>span,.agenda-nearest-note { color:#d3c3c9;font-size:12px;line-height:1.6; }
.agenda-controls>div { display:flex;gap:8px; }
.agenda-controls button { width:48px;height:48px;border:1px solid #ffffff44;color:#fff;background:#0b0b0c50;cursor:pointer;font-size:24px;transition:background .35s ease; }
.agenda-controls button:hover { background:var(--agenda-secondary); }
.agenda-controls button:disabled { opacity:.25;cursor:default; }
.agenda-nearest-note { margin:24px 0 0; }
@media(max-width:600px) { .landing-hero { padding:125px 18px 90px; }.landing-hero h1 { font-size:clamp(34px,9.5vw,56px);line-height:1.08; }.landing-hero-backdrop img { object-position:center; }.landing-hero-backdrop::after { background:linear-gradient(0deg,#0b0b0c,#180911ba 42%,#17090c80); }.landing-agenda-card h3 { font-size:30px; } }
